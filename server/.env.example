# API
NODE_ENV=development
PORT=4000
# Local dev: docker compose up -d mongo (mongo:8 on port 27017)
# Production (Render): MongoDB Atlas connection string, e.g. mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/lumina_noir_portfolio
MONGODB_URI=mongodb://127.0.0.1:27017/lumina_noir_portfolio
# Local dev
CORS_ORIGIN=http://localhost:5173
# Production: '*' or your exact domain (e.g. https://lumina-noir-portfolio.onrender.com)
RATE_LIMIT_MAX=20
LOG_LEVEL=info